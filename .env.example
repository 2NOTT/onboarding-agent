# ===== 企业入职助手 MVP 环境配置 =====
# 复制本文件为 .env 后按需修改。不配置 LLM_API_KEY 或设置 FORCE_MOCK=true 时，
# 系统自动进入 Mock 模式（所有 Skill 由本地规则引擎生成），项目仍可完整演示。

# 大模型 API Key（留空则使用 Mock 模式）
LLM_API_KEY=

# 大模型 API Base URL（OpenAI 兼容接口，如 https://api.openai.com/v1 或其他兼容网关）
LLM_BASE_URL=https://api.openai.com/v1

# 默认模型名称（Skill 未单独指定 model 时使用）
LLM_MODEL=gpt-4o-mini

# 服务端口
PORT=8000

# 强制 Mock 模式（true / false）：为 true 时即使配置了 API Key 也不调用大模型
FORCE_MOCK=false

# 大模型调用超时时间（秒）
LLM_TIMEOUT=60

# ===== Coze 工作流 Tool（run_coze_workflow）=====
# Coze API 访问令牌（ PAT，平台个人令牌）。留空时该 Tool 以本地 Mock 输出
COZE_API_TOKEN=
# Coze API 地址（国内站 https://api.coze.cn，海外站 https://api.coze.com）
COZE_API_BASE=https://api.coze.cn
# 默认工作流 ID（也可在 Tool 步骤输入中用 workflow_id 覆盖）
COZE_WORKFLOW_ID=7694957124648747008
# Coze 工作流调用超时时间（秒）
COZE_TIMEOUT=60
